@page
@model Mega.Web.Pages.AccesoModel
@{ ViewData["Title"] = "Iniciar sesión"; }
<section class="login-grid">
    <div class="login-intro">
        <img class="login-logo" src="~/brand/logo-negative.svg" alt="Minisúper MEGA" width="480" height="255" />
        <h1>Tu tienda,<br />en buenas manos.</h1>
        <p>Ventas, caja e inventario.<br />Todo listo para el día a día de MEGA.</p>
    </div>
    <div class="login-access">
        <div class="card login-card">
            <span class="badge success">Acceso local</span>
            <h2>¡Qué bueno verte!</h2>
            <p class="muted">Ingresa con tu cuenta para comenzar.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert error" role="alert"></div>
                <label asp-for="Account">Usuario</label><input asp-for="Account" autocomplete="username" required maxlength="100" autofocus />
                <label asp-for="Password">Contraseña</label><input asp-for="Password" type="password" autocomplete="current-password" required maxlength="200" />
                <button type="submit" class="button primary full">Entrar a MEGA</button>
            </form>
            <p class="small muted login-privacy">Cuenta individual · conserva tus credenciales privadas.</p>
        </div>
        @if (Model.Demo)
        {
            <details class="demo-help"><summary>DEMOSTRACIÓN · DATOS FICTICIOS</summary><p>cajero · admin · inventario · propietario</p><p>Contraseña: <code>MegaDemo2026!</code></p><small>Solo para pruebas académicas.</small></details>
        }
    </div>
</section>
