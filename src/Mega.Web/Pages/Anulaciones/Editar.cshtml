@page
@model Mega.Web.Pages.Anulaciones.EditarModel
@using Mega.Web.Services
@{ViewData["Title"]="Anulación completa de venta";}
<div class="page-heading"><div><span class="eyebrow">ANULACIÓN · @(Model.Saved?.Estado??"NUEVA")</span><h1>Anulación completa de venta</h1><p class="muted">Conserva venta, comprobante y cierres originales. No admite devolución parcial del cobro.</p></div><a class="button secondary" asp-page="Index">Volver</a></div><partial name="_Notice"/>
<form method="post" class="card"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/><input asp-for="Input.Key" type="hidden"/><fieldset class="plain-fieldset" disabled="@(!Model.Editable)">
@if(Model.Input.Id is null){<label asp-for="Input.SaleId">Venta que se solicita anular</label><select asp-for="Input.SaleId"><option value="0">Selecciona venta</option>@foreach(var v in Model.Sales){<option value="@v.Id">@v.Folio · @Formats.Money(v.TotalCentavos) · @Formats.Date(v.Fecha)</option>}</select>}else{<input asp-for="Input.SaleId" type="hidden"/><p><strong>@Model.ContentData?.Folio · @Formats.Money(Model.ContentData?.Total??0)</strong></p>}
<label asp-for="Input.Reference">Referencia única de anulación</label><input asp-for="Input.Reference" required maxlength="100"/><label asp-for="Input.Reason">Motivo de anulación</label><textarea asp-for="Input.Reason" required maxlength="1000"></textarea><label asp-for="Input.Evidence">Referencia de evidencia de anulación</label><input asp-for="Input.Evidence" required maxlength="1000"/>
<label asp-for="Input.Restock">Reincorporación de mercadería</label><select asp-for="Input.Restock"><option value="">Define la reincorporación</option><option value="true">Reincorporar toda la mercadería físicamente verificada</option><option value="false">No reincorporar mercadería; conservar motivo/evidencia</option></select><label class="check-row"><input asp-for="Input.PhysicalVerified"/> Comprobé físicamente toda la mercadería que se reincorpora y su disponibilidad.</label><p class="help">Seleccionar reincorporación exige esa comprobación. Las cantidades, lotes y costos proceden de la venta original. Aprobar no registra una entrega ficticia de dinero.</p>
@if(Model.Editable){<button class="button primary">Guardar preparación de anulación</button>}</fieldset></form>
@if(Model.Saved is {} r){<section class="card receiving-line"><h2>Revisión y fondos</h2><p>Estado: @r.Estado · versión @r.Version</p><p>Efectivo previsto: @Formats.Money(r.EfectivoADevolverCentavos) · devolución registrada: @Formats.Money(r.EfectivoDevueltoCentavos)</p><p>Regularización: @r.RegularizacionEstado.Replace('_',' ')</p>
@if(r.FondosExternosARegularizarCentavos>0){<div class="alert warning">Fondos externos pendientes: @Formats.Money(r.FondosExternosARegularizarCentavos-r.FondosExternosRegularizadosCentavos). Requieren conciliación de gestión y procedimiento validado.</div>}
@if(Model.Editable){<form method="post" asp-page-handler="Submit"><input name="Input.Id" type="hidden" value="@r.Id"/><input name="Input.Version" type="hidden" value="@r.Version"/><button class="button primary">Enviar versión guardada a revisión</button></form>}
<table><thead><tr><th>Versión</th><th>Decisión</th><th></th></tr></thead><tbody>@foreach(var a in Model.Reviews){<tr><td>@a.ObjetoVersion</td><td>@a.Decision @(a.InvalidadaEn is null?"":"· invalidada")</td><td><a asp-page="Revision" asp-route-id="@a.Id">Ver contenido revisado →</a></td></tr>}</tbody></table>
@if(r.Estado=="Autorizada"&&r.EfectivoDevueltoCentavos<r.EfectivoADevolverCentavos&&User.HasClaim("caja","1")){<form method="post" asp-page-handler="Refund" class="subsection"><input name="Input.Id" type="hidden" value="@r.Id"/><input name="Input.Version" type="hidden" value="@r.Version"/><h3>Registrar entrega real de efectivo</h3><p class="help">Se registra en tu turno actual abierto. No altera el cierre original; requiere saldo suficiente.</p><label asp-for="ActionEvidence">Evidencia de devolución efectiva</label><input asp-for="ActionEvidence" required maxlength="1000"/><label class="check-row"><input asp-for="HandedOver" required/> Entregué efectivamente @Formats.Money(r.EfectivoADevolverCentavos) al cliente.</label><button class="button primary">Registrar devolución efectiva una vez</button></form>}
@if(Model.Editable){<form method="post" asp-page-handler="Cancel" class="subsection"><input name="Input.Id" type="hidden" value="@r.Id"/><input name="Input.Version" type="hidden" value="@r.Version"/><label asp-for="ActionEvidence">Motivo de cancelación</label><input asp-for="ActionEvidence" required maxlength="1000"/><button class="button secondary">Cancelar solicitud</button></form>}</section>}
