@page
@model Mega.Web.Pages.Anulaciones.RevisionModel
@using Mega.Web.Services
@{ViewData["Title"]="Revisar anulación";var d=Model.Data;}
<div class="page-heading"><div><span class="eyebrow">OTRA CUENTA DE GESTIÓN</span><h1>Revisar anulación de @d.Folio</h1><p class="muted">Versión @d.Version · devolución completa prevista @Formats.Money(d.Total).</p></div><a class="button secondary" asp-page="Editar" asp-route-id="@d.RequestId">Ver solicitud</a></div><partial name="_Notice"/>
<div class="alert info">@Model.Review.Decision. @(Model.Review.Decision!="pendiente"?"Decisión histórica conservada.":Model.Current?"El contenido coincide con la revisión actual.":"La revisión fue invalidada o cambió el contenido; se requiere una nueva revisión.")</div>
<section class="card"><h2>Motivo y evidencia</h2><p>@d.Reason</p><p>@d.Evidence</p><div class="subsection"><h3>Mercadería: @d.RestockState.Replace('_',' ')</h3><table><thead><tr><th>Producto</th><th>Lote</th><th>Reincorporar</th><th>Costo histórico</th></tr></thead><tbody>@foreach(var l in d.Reentries){<tr><td>@l.Product</td><td>@(l.LotId?.ToString()??"Sin lote")</td><td>@(l.Quantity/ReceivingService.Power(l.Scale))</td><td>@(l.Cost is long cost?"C$ "+(cost/ReceivingService.Power(l.CostScale!.Value)):"Desconocido")</td></tr>}</tbody></table></div><p>Efectivo por devolver tras aprobar: @Formats.Money(d.Cash). La entrega se registra por separado con evidencia.</p></section>
<section class="card receiving-line"><h2>Decisión</h2><p class="content-hash">Huella: @Model.Review.ContenidoHash</p>@if(Model.CanDecide){<form method="post"><input asp-for="Id" type="hidden"/><input asp-for="ExpectedVersion" type="hidden"/><input asp-for="ExpectedHash" type="hidden"/><label asp-for="Reason">Motivo de decisión y evidencia revisada</label><textarea asp-for="Reason" required maxlength="1000"></textarea><div class="toolbar"><button class="button primary" asp-page-handler="Approve">Autorizar anulación y reincorporación declarada</button><button class="button secondary" asp-page-handler="Reject">Rechazar anulación</button></div></form>}else if(Model.Review.Decision=="pendiente"&&Model.Current){<p>Debe decidir otra cuenta Administrador o Propietario.</p>}else{<p>@Model.Review.Motivo</p>}</section>
