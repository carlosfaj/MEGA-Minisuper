@page
@model Mega.Web.Pages.BitacoraModel
@using Mega.Web.Services
@{ViewData["Title"]="Bitácora";}
<div class="page-heading"><div><span class="eyebrow">CONTROL</span><h1>Bitácora</h1><p class="muted">Últimos 100 eventos. El historial operativo se conserva sin edición.</p></div></div><form method="get" class="form-grid"><div><label asp-for="Search">Buscar acción, entidad o clave</label><input asp-for="Search" maxlength="200"/></div><div><label asp-for="Result">Resultado</label><select asp-for="Result"><option value="">Todos</option><option value="exito">Éxito</option><option value="rechazado">Rechazado</option><option value="fallo">Fallo</option><option value="pendiente">Pendiente</option><option value="incierto">Incierto</option></select></div><button class="button secondary">Filtrar bitácora</button></form><section class="card"><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Cuenta</th><th>Acción</th><th>Referencia</th><th>Resultado</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@Formats.Date(row.Fecha)</td><td>@(row.UsuarioId is long uid?Model.Users.GetValueOrDefault(uid,"Cuenta histórica"):"Tarea automática")</td><td>@row.Accion</td><td>@row.Entidad @row.EntidadId</td><td><span class="badge @(row.Resultado=="exito"?"success":"warning")">@row.Resultado</span><details><summary>Detalle del evento</summary><p>Clave: @row.ClaveOperacion · autorización #@row.AutorizacionId</p><pre class="audit-detail">@row.DatosCambio</pre></details></td></tr>}</tbody></table></div></section>
