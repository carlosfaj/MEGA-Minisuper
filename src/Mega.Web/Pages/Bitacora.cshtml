@page
@model Mega.Web.Pages.BitacoraModel
@using Mega.Web.Services
@{ViewData["Title"]="Bitácora";}
<div class="page-heading"><div><span class="eyebrow">CONTROL</span><h1>Bitácora</h1><p class="muted">Últimos 100 eventos. El historial operativo se conserva sin edición.</p></div></div><section class="card"><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Cuenta</th><th>Acción</th><th>Referencia</th><th>Resultado</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@Formats.Date(row.Fecha)</td><td>@(row.UsuarioId is long uid?Model.Users.GetValueOrDefault(uid,"Cuenta histórica"):"Tarea automática")</td><td>@row.Accion</td><td>@row.Entidad @row.EntidadId</td><td><span class="badge @(row.Resultado=="exito"?"success":"warning")">@row.Resultado</span></td></tr>}</tbody></table></div></section>
