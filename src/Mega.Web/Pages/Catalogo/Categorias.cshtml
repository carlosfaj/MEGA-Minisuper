@page
@model Mega.Web.Pages.Catalogo.CategoriasModel
@{ViewData["Title"]="Categorías";}
<div class="page-heading"><div><span class="eyebrow">CATÁLOGO</span><h1>Categorías</h1></div><a class="button secondary" asp-page="/Catalogo/Index">Volver al catálogo</a></div><partial name="_Notice"/>
<div class="editor-grid"><section class="card"><h2>@(Model.Input.Id is null?"Nueva categoría":"Editar categoría")</h2><form method="post"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Hash" type="hidden"/><label asp-for="Input.Name">Nombre</label><input asp-for="Input.Name" required maxlength="200"/><label class="check-row"><input asp-for="Input.Active"/> Categoría activa</label><button class="button primary" type="submit">Guardar categoría</button></form></section><section class="card"><div class="card-heading"><h2>Categorías registradas</h2><a asp-page="/Catalogo/Categorias">Añadir otra</a></div><table><thead><tr><th>Nombre</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var item in Model.Categories){<tr><td>@item.Nombre</td><td>@(item.Activo==1?"Activa":"Desactivada")</td><td><a asp-route-id="@item.Id">Editar</a></td></tr>}</tbody></table></section></div>
