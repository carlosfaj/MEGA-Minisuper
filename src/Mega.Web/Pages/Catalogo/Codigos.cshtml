@page
@model Mega.Web.Pages.Catalogo.CodigosModel
@{ViewData["Title"]="Códigos de producto";}
<div class="page-heading"><div><span class="eyebrow">CATÁLOGO</span><h1>Códigos de producto</h1><p class="muted">@Model.Product.Nombre</p></div><a class="button secondary" asp-page="/Catalogo/Producto" asp-route-id="@Model.Product.Id">Volver al producto</a></div><partial name="_Notice"/>
<div class="editor-grid"><section class="card"><h2>Añadir código</h2><form method="post"><input asp-for="Input.ProductId" type="hidden"/><input asp-for="Input.ProductVersion" type="hidden"/><label asp-for="Input.PresentationId">Presentación</label><select asp-for="Input.PresentationId" required><option value="">Seleccionar</option>@foreach(var p in Model.Presentations.Where(x=>x.Activo==1)){<option value="@p.Id">@p.Nombre</option>}</select><label asp-for="Input.Code">Código o código de barras</label><input asp-for="Input.Code" maxlength="128" required autocomplete="off"/><p class="muted small">Se conservan los ceros iniciales. Desactivar un código no permite reasignarlo a otro producto.</p><button class="button primary" type="submit">Añadir código</button></form></section><section class="card"><h2>Códigos registrados</h2><table><thead><tr><th>Código</th><th>Presentación</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var c in Model.Codes){<tr><td><strong>@c.Codigo</strong></td><td>@Model.Presentations.Single(p=>p.Id==c.PresentacionId).Nombre</td><td>@(c.Activo==1?"Activo":"Desactivado")</td><td><form method="post" asp-page-handler="Estado"><input type="hidden" name="productId" value="@Model.Product.Id"/><input type="hidden" name="productVersion" value="@Model.Product.Version"/><input type="hidden" name="codeId" value="@c.Id"/><input type="hidden" name="active" value="@(c.Activo==1?"false":"true")"/><button class="button text-button" type="submit">@(c.Activo==1?"Desactivar":"Activar")</button></form></td></tr>}</tbody></table></section></div>
