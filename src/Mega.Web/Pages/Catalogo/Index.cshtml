@page
@model Mega.Web.Pages.Catalogo.IndexModel
@{ViewData["Title"]="Catálogo";}
<div class="page-heading"><div><span class="eyebrow">GESTIÓN</span><h1>Catálogo de productos</h1><p class="muted">Productos, presentaciones, códigos y condiciones de venta.</p></div><div class="button-row"><a class="button secondary" asp-page="/Catalogo/Categorias">Categorías</a><a class="button primary" asp-page="/Catalogo/Producto">＋ Nuevo producto</a></div></div>
<partial name="_Notice"/><section class="card"><form method="get" class="search-row"><label class="sr-only" for="Search">Buscar producto o código</label><input asp-for="Search" type="search" placeholder="Buscar nombre o código…"/><button class="button secondary" type="submit">Buscar</button></form>
<div class="table-wrap"><table><thead><tr><th>Producto</th><th>Categoría</th><th>Unidad base</th><th>Presentaciones</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td><strong>@row.Product.Nombre</strong></td><td>@row.Category</td><td>@row.Product.UnidadBase</td><td>@row.Presentations</td><td><span class="badge @(row.Product.Activo==1?"success":"neutral")">@(row.Product.Activo==1?"Activo":"Desactivado")</span></td><td><a asp-page="/Catalogo/Producto" asp-route-id="@row.Product.Id">Gestionar →</a></td></tr>}</tbody></table></div>@if(Model.Rows.Count==0){<div class="empty"><p>No hay productos que coincidan con la búsqueda.</p></div>}</section>
