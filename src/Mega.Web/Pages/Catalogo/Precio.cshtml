@page
@model Mega.Web.Pages.Catalogo.PrecioModel
@using Mega.Web.Services
@{ViewData["Title"]="Precios";}
<div class="page-heading"><div><span class="eyebrow">CATÁLOGO</span><h1>Precios y vigencias</h1><p class="muted">@Model.Product.Nombre · Las ventas anteriores conservan sus importes.</p></div><a class="button secondary" asp-page="/Catalogo/Producto" asp-route-id="@Model.Product.Id">Volver al producto</a></div><partial name="_Notice"/>
<div class="editor-grid"><section class="card"><h2>Registrar precio</h2><form method="post"><input asp-for="Input.ProductId" type="hidden"/><input asp-for="Input.ProductVersion" type="hidden"/><label asp-for="Input.PresentationId">Presentación</label><select asp-for="Input.PresentationId" required><option value="">Seleccionar</option>@foreach(var p in Model.Presentations.Where(x=>x.Activo==1)){<option value="@p.Id">@p.Nombre</option>}</select><label asp-for="Input.Amount">Precio por presentación (C$)</label><input asp-for="Input.Amount" required inputmode="decimal" placeholder="0.00"/><label class="check-row"><input asp-for="Input.Schedule"/> Programar para una fecha futura</label><label asp-for="Input.LocalStart">Fecha y hora de inicio, si se programa</label><input asp-for="Input.LocalStart" type="datetime-local"/><p class="muted small">Sin programación se aplica ahora. Hora local UTC−6. El precio nuevo cierra la vigencia anterior sin cambiar sus importes.</p><button class="button primary" type="submit">Registrar precio</button></form></section>
<section class="card"><h2>Historial de precios</h2><div class="table-wrap"><table><thead><tr><th>Presentación</th><th>Precio</th><th>Desde</th><th>Hasta</th></tr></thead><tbody>@foreach(var p in Model.Prices){<tr><td>@Model.Presentations.Single(x=>x.Id==p.PresentacionId).Nombre</td><td>@Formats.Money(p.PrecioCentavos)</td><td>@Formats.DateWithSeconds(p.VigenteDesde)</td><td>@(p.VigenteHasta is null?"Sin fecha final":Formats.DateWithSeconds(p.VigenteHasta))</td></tr>}</tbody></table></div></section></div>
