@page
@model Mega.Web.Pages.Catalogo.PresentacionModel
@{ViewData["Title"]="Presentación";}
<div class="page-heading"><div><span class="eyebrow">CATÁLOGO</span><h1>@(Model.Input.Id is null?"Nueva presentación":"Editar presentación")</h1><p class="muted">@Model.Product.Nombre</p></div><a class="button secondary" asp-page="/Catalogo/Producto" asp-route-id="@Model.Product.Id">Volver al producto</a></div><partial name="_Notice"/>
<section class="card form-card"><form method="post"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.ProductId" type="hidden"/><input asp-for="Input.ProductVersion" type="hidden"/><input asp-for="Input.Version" type="hidden"/><label asp-for="Input.Name">Nombre de presentación</label><input asp-for="Input.Name" required maxlength="200" placeholder="Unidad, paquete, libra…"/><label asp-for="Input.Factor">Cantidad equivalente en @Model.Product.UnidadBase</label><input asp-for="Input.Factor" required inputmode="decimal"/><p class="muted small">Por ejemplo, un paquete de 6 unidades equivale a 6 en la unidad base. Una equivalencia ya utilizada se conserva en el historial.</p><label class="check-row"><input asp-for="Input.Active"/> Presentación activa</label><button type="submit" class="button primary">Guardar presentación</button></form></section>
