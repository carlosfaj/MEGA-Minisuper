@page "{id:long?}"
@model Mega.Web.Pages.Catalogo.ProductoModel
@{ViewData["Title"]=Model.Input.Id is null?"Nuevo producto":"Gestionar producto";}
<div class="page-heading"><div><span class="eyebrow">CATÁLOGO</span><h1>@ViewData["Title"]</h1><p class="muted">La desactivación conserva los registros anteriores.</p></div><a class="button secondary" asp-page="/Catalogo/Index">Volver al catálogo</a></div><partial name="_Notice"/>
<div class="editor-grid"><section class="card"><h2>Datos del producto</h2><form method="post"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/>
<label asp-for="Input.Name">Nombre</label><input asp-for="Input.Name" required maxlength="200"/><label asp-for="Input.CategoryId">Categoría</label><select asp-for="Input.CategoryId" required><option value="">Seleccionar categoría</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Nombre @(c.Activo==1?"":"(desactivada)")</option>}</select><a class="small" asp-page="/Catalogo/Categorias">Gestionar categorías</a>
<div class="field-grid"><div><label asp-for="Input.Control">Control de cantidad</label><select asp-for="Input.Control"><option value="unidad">Unidades indivisibles</option><option value="peso">Peso manual</option></select></div><div><label asp-for="Input.Unit">Unidad base</label><input asp-for="Input.Unit" required maxlength="30" placeholder="unidad, lb o kg"/></div></div>
<label asp-for="Input.Minimum">Existencia mínima, en unidad base</label><input asp-for="Input.Minimum" inputmode="decimal" required/><label class="check-row"><input asp-for="Input.Expiration"/> Controlar vencimiento por lote</label><label class="check-row"><input asp-for="Input.Active"/> Producto activo</label><p class="muted small">Con historia registrada, la unidad base y el control de cantidad se conservan. El mínimo es una alerta y no agrega existencias.</p><button class="button primary" type="submit">Guardar producto</button></form></section>
<section class="card"><h2>Presentaciones y venta</h2>@if(Model.Input.Id is long id){<div class="button-row"><a class="button secondary" asp-page="/Catalogo/Presentacion" asp-route-productId="@id">＋ Presentación</a><a class="button secondary" asp-page="/Catalogo/Codigos" asp-route-productId="@id">Códigos</a><a class="button secondary" asp-page="/Catalogo/Precio" asp-route-productId="@id">Precios</a></div><div class="table-wrap"><table><thead><tr><th>Presentación</th><th>Equivalencia</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model.Presentations){<tr><td>@p.Nombre</td><td>@((p.FactorEscalado/(decimal)Math.Pow(10,p.EscalaFactor)).ToString("0.######")) @Model.Input.Unit</td><td>@(p.Activo==1?"Activa":"Desactivada")</td><td><a asp-page="/Catalogo/Presentacion" asp-route-productId="@id" asp-route-id="@p.Id">Editar</a></td></tr>}</tbody></table></div>@if(Model.Presentations.Count==0){<div class="alert info">Añade al menos una presentación y su precio para vender este producto.</div>}}
else{<div class="alert info">Guarda primero el producto. Después podrás añadir presentaciones, códigos y precios.</div>}</section></div>
