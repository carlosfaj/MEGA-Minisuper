@page
@model Mega.Web.Pages.Comercial.ImpuestosModel
@using Mega.Web.Services
@{ViewData["Title"]="Impuestos y exenciones";}
<div class="page-heading"><div><span class="eyebrow">CONDICIONES CONFIGURADAS</span><h1>Impuestos y exenciones</h1><p class="muted">Las tasas se introducen expresamente; configurar no acredita validez fiscal del comprobante.</p></div><a class="button secondary" asp-page="Index">Volver</a></div><partial name="_Notice"/>
<div class="alert info">Los precios se tratan como base antes de estos impuestos adicionales. Se calculan sobre el subtotal después del descuento, sin impuesto en cascada, y se redondean por línea a centavos. Una exención no puede coincidir con otras condiciones activas del producto.</div>
<div class="editor-grid"><form method="post" class="card"><h2>@(Model.Input.Id is null?"Crear condición":"Editar condición")</h2><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Hash" type="hidden"/><label asp-for="Input.Name">Nombre de condición</label><input asp-for="Input.Name" required maxlength="200"/><label asp-for="Input.Rate">Tasa porcentual configurada</label><input asp-for="Input.Rate" inputmode="decimal" required maxlength="32"/><div class="form-grid"><div><label asp-for="Input.Start">Inicio local</label><input asp-for="Input.Start" type="datetime-local" step="1" required/></div><div><label asp-for="Input.End">Fin local (opcional)</label><input asp-for="Input.End" type="datetime-local" step="1"/></div></div><label class="check-row"><input asp-for="Input.Exempt"/> Es una exención (tasa cero y motivo)</label><label asp-for="Input.ExemptionReason">Motivo de exención</label><textarea asp-for="Input.ExemptionReason" maxlength="1000"></textarea><label>Productos incluidos</label><div class="option-picker">@foreach(var p in Model.Products){<label class="check-row"><input name="Input.Products" type="checkbox" value="@p.Id" checked="@Model.Input.Products.Contains(p.Id)"/> @p.Nombre</label>}</div><label class="check-row"><input asp-for="Input.Active"/> Condición activa</label><button class="button primary">Guardar condición</button></form>
<section class="card table-card"><h2>Condiciones registradas</h2><table><thead><tr><th>Nombre</th><th>Tasa</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var t in Model.Rows){<tr><td>@t.Nombre<small>@(t.EsExencion==1?"Exención":"Tasa ordinaria")</small></td><td>@(t.TasaEscalada/ReceivingService.Power(t.EscalaTasa))%</td><td>@(t.Activo==1?"Activa":"Desactivada")</td><td><a asp-page="Impuestos" asp-route-id="@t.Id">Editar →</a></td></tr>}</tbody></table></section></div>
