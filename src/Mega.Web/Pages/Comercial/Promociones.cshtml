@page
@model Mega.Web.Pages.Comercial.PromocionesModel
@using Mega.Web.Services
@{ViewData["Title"]="Promociones";}
<div class="page-heading"><div><span class="eyebrow">CONDICIONES COMERCIALES</span><h1>Promociones</h1><p class="muted">Exclusivas por línea; menor número de prioridad se evalúa primero. El empate se resuelve por identidad.</p></div><a class="button secondary" asp-page="Index">Volver</a></div><partial name="_Notice"/>
<div class="editor-grid"><form method="post" class="card"><h2>@(Model.Input.Id is null?"Crear promoción":"Editar promoción")</h2><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/><label asp-for="Input.Name">Nombre de promoción</label><input asp-for="Input.Name" required maxlength="200"/><div class="form-grid"><div><label asp-for="Input.Type">Tipo de descuento</label><select asp-for="Input.Type"><option value="porcentaje">Porcentaje</option><option value="importe_fijo">Importe fijo C$ por presentación</option></select></div><div><label asp-for="Input.Value">Valor (porcentaje o C$)</label><input asp-for="Input.Value" inputmode="decimal" required maxlength="32"/></div><div><label asp-for="Input.Start">Inicio local</label><input asp-for="Input.Start" type="datetime-local" step="1" required/></div><div><label asp-for="Input.End">Fin local</label><input asp-for="Input.End" type="datetime-local" step="1" required/></div></div><label asp-for="Input.Priority">Prioridad (menor primero)</label><input asp-for="Input.Priority" type="number" min="0" required/><label>Presentaciones incluidas</label><div class="option-picker">@foreach(var p in Model.Options){<label class="check-row"><input name="Input.Presentations" type="checkbox" value="@p.Id" checked="@Model.Input.Presentations.Contains(p.Id)"/> @p.Name</label>}</div><label class="check-row"><input asp-for="Input.Active"/> Promoción activa</label><p class="help">El importe fijo se multiplica por las presentaciones vendidas. El descuento no supera el subtotal; una compra de total cero permanece deshabilitada.</p><button class="button primary">Guardar promoción</button></form>
<section class="card table-card"><h2>Promociones registradas</h2><table><thead><tr><th>Nombre</th><th>Vigencia</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model.Rows){<tr><td>@p.Nombre<small>@p.Tipo · versión @p.Version</small></td><td>@Formats.Date(p.Inicio)<small>@Formats.Date(p.Fin)</small></td><td>@(p.Activa==1?"Activa":"Desactivada")</td><td><a asp-page="Promociones" asp-route-id="@p.Id">Editar →</a></td></tr>}</tbody></table></section></div>
