@page "{id:long}"
@model Mega.Web.Pages.ComprobanteModel
@using Mega.Web.Services
@{ViewData["Title"]="Comprobante";var sale=Model.Sale;var snapshot=Model.Snapshot;}
<div class="page-heading"><div><span class="eyebrow">VENTA CONFIRMADA</span><h1>Venta registrada</h1><p class="muted">Venta, pago, caja y existencias guardados correctamente.</p></div><a class="button primary" asp-page="/Venta">＋ Nueva venta</a></div>
<div class="receipt-grid"><section class="card receipt"><div class="receipt-header"><h2>@snapshot.GetProperty("negocio").GetString()</h2><p>@snapshot.GetProperty("direccion").GetString()</p><span class="badge neutral">Comprobante interno · sin validez fiscal acreditada</span></div><div class="receipt-meta"><div><span>Folio</span><strong>@sale.Folio</strong></div><div><span>Fecha</span><strong>@Formats.Date(sale.Fecha)</strong></div><div><span>Operador</span><strong>@snapshot.GetProperty("operador").GetString()</strong></div></div>
<div class="table-wrap"><table><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Importe</th></tr></thead><tbody>@foreach(var line in snapshot.GetProperty("lineas").EnumerateArray()){<tr><td><strong>@line.GetProperty("name").GetString()</strong><small>@line.GetProperty("presentation").GetString()</small></td><td>@((line.GetProperty("quantity").GetInt64()/(decimal)Math.Pow(10,line.GetProperty("quantityScale").GetInt32())).ToString("0.###"))</td><td>@Formats.Money(line.GetProperty("price").GetInt64())</td><td>@Formats.Money(line.GetProperty("subtotal").GetInt64())</td></tr>}</tbody></table></div>
<div class="totals"><div><span>Subtotal</span><span>@Formats.Money(sale.SubtotalCentavos)</span></div><div><span>Impuesto aplicado</span><span>@Formats.Money(sale.ImpuestoCentavos)</span></div><div class="total"><strong>Total</strong><strong id="receipt-total">@Formats.Money(sale.TotalCentavos)</strong></div><div><span>Recibido en efectivo</span><span>@Formats.Money(Model.Payment.RecibidoCentavos??0)</span></div><div><strong>Cambio</strong><strong id="receipt-change">@Formats.Money(Model.Payment.CambioCentavos??0)</strong></div></div><p class="muted small">Los datos de este comprobante conservan las condiciones registradas al confirmar la venta.</p></section>
<aside><section class="card"><h2>Resumen</h2><div class="summary-pair"><span>Estado comercial</span><span class="badge success">@sale.Estado</span></div><div class="summary-pair"><span>Medio de pago</span><strong>Efectivo</strong></div><div class="summary-pair"><span>Impresión</span><span class="badge warning">@Model.PrintState</span></div><div class="alert warning">La venta está confirmada. El agente de impresión está pendiente de integrar; este avance no acredita salida física de papel.</div><a class="button secondary full" asp-page="/Ventas">Volver a ventas del turno</a></section></aside></div>
