@page
@model Mega.Web.Pages.Conteos.EditarModel
@using Mega.Web.Services
@{ViewData["Title"]="Conteo físico";}
<div class="page-heading"><div><span class="eyebrow">INVENTARIO · @(Model.Saved?.Estado??"NUEVO")</span><h1>Conteo físico</h1><p class="muted">Cantidades en unidad base; sin valoración ni márgenes.</p></div><a class="button secondary" asp-page="Index">Volver</a></div><partial name="_Notice"/>
<form method="post"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/><fieldset class="plain-fieldset" disabled="@(!Model.Editable)"><section class="card"><label asp-for="Input.Reference">Referencia única del conteo</label><input asp-for="Input.Reference" required maxlength="100"/><label asp-for="Input.Notes">Observaciones generales</label><textarea asp-for="Input.Notes" maxlength="2000"></textarea><p class="help">Sin lote: total del producto, incluido lo distribuido en lotes. Con lote: solo ese lote. No mezcles ambos alcances para el mismo producto. Cada guardado conserva las cantidades observadas y el saldo registrado en ese momento.</p></section>
@for(var i=0;i<Model.Input.Lines.Count;i++){<section class="card receiving-line"><h2>Observación @(i+1)</h2><div class="form-grid"><div><label asp-for="Input.Lines[i].ProductId">Producto y unidad base</label><select asp-for="Input.Lines[i].ProductId"><option value="0">Selecciona producto</option>@foreach(var p in Model.Products){<option value="@p.Id">@p.Nombre · @p.UnidadBase @(p.Activo==0?"(desactivado)":"")</option>}</select></div><div><label asp-for="Input.Lines[i].LotId">Alcance del conteo</label><select asp-for="Input.Lines[i].LotId"><option value="">Total del producto</option>@foreach(var lot in Model.Lots){<option value="@lot.Id">@Model.Products.Single(p=>p.Id==lot.ProductoId).Nombre · lote @(lot.Referencia??lot.Id.ToString()) · @lot.Vencimiento</option>}</select></div><div><label asp-for="Input.Lines[i].Physical">Cantidad física en unidad base</label><input asp-for="Input.Lines[i].Physical" inputmode="decimal" maxlength="32"/></div><div><label asp-for="Input.Lines[i].Note">Observación de la cantidad</label><input asp-for="Input.Lines[i].Note" maxlength="1000"/></div></div></section>}
@if(Model.Editable){<div class="card receiving-line"><label class="check-row"><input asp-for="Input.PhysicalChecked" required/> He comprobado físicamente estas cantidades antes de este guardado.</label><div class="toolbar"><button class="button primary">Guardar conteo</button><button class="button secondary" asp-page-handler="AddLine" formnovalidate>Añadir observación</button></div></div>}</fieldset></form>
@if(Model.Saved is not null){<section class="card receiving-line"><h2>Comparación guardada</h2><p class="help">Referencia al inventario confirmado: operación #@(Model.Saved.OperacionReferenciaId?.ToString()??"ninguna"). La diferencia es físico menos registrado. No modifica existencias.</p><table><thead><tr><th>Producto / alcance</th><th>Registrado</th><th>Físico</th><th>Diferencia</th></tr></thead><tbody>@foreach(var d in Model.SavedLines){<tr><td>@Model.Products.Single(p=>p.Id==d.ProductoId).Nombre · @(d.LoteId is null?"total":"lote #"+d.LoteId)</td><td>@(d.SaldoReferenciaEscalado/ReceivingService.Power(d.Escala))</td><td>@(d.CantidadFisicaEscalada/ReceivingService.Power(d.Escala))</td><td>@((d.CantidadFisicaEscalada-d.SaldoReferenciaEscalado)/ReceivingService.Power(d.Escala))</td></tr>}</tbody></table>
@if(Model.Editable){<form method="post" asp-page-handler="Finalize"><input name="Input.Id" type="hidden" value="@Model.Saved.Id"/><input name="Input.Version" type="hidden" value="@Model.Saved.Version"/><button class="button primary">Finalizar versión guardada sin ajustar existencias</button></form>}else{<p>Este registro conserva su contenido. Los ajustes requieren una solicitud y autorización independientes, pendientes de integrar.</p>}</section>}
