@page
@model Mega.Web.Pages.CorreosModel
@using Mega.Web.Services
@{ViewData["Title"]="Correo y reportes";}
<div class="page-heading"><div><span class="eyebrow">GESTIÓN</span><h1>Correo y reportes</h1><p class="muted">La operación local continúa sin Internet. El reporte solicitado se conserva con su contenido original.</p></div><a class="button secondary" asp-page="/Reportes">Preparar reporte</a></div><partial name="_Notice"/>
<details class="card"><summary>Configurar servidor de correo</summary><form method="post" asp-page-handler="Settings"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/><label class="check-row"><input asp-for="Input.Enabled"/> Habilitar el agente de correo con esta configuración</label><label asp-for="Input.Host">Servidor SMTP</label><input asp-for="Input.Host" maxlength="253" autocomplete="off"/><div class="field-grid"><div><label asp-for="Input.Port">Puerto SMTP</label><input asp-for="Input.Port" type="number" min="1" max="65535"/></div><div><label asp-for="Input.Security">Seguridad de conexión</label><select asp-for="Input.Security"><option value="starttls">STARTTLS obligatorio</option><option value="tls">TLS desde la conexión</option></select></div></div><label asp-for="Input.Sender">Correo remitente</label><input asp-for="Input.Sender" type="email" maxlength="254"/><label asp-for="Input.User">Usuario SMTP, si requiere autenticación</label><input asp-for="Input.User" maxlength="254" autocomplete="off"/><label for="smtp-secret">Nueva credencial SMTP</label><input id="smtp-secret" name="Input.Password" type="password" maxlength="1000" autocomplete="new-password"/><p class="muted small">@(Model.HasSecret?"Ya existe una credencial protegida; deja vacío para conservarla.":"No hay credencial configurada.") Se protege con el perfil de Windows de este equipo. En otro perfil o equipo deberás configurarla nuevamente.</p><label class="check-row"><input asp-for="Input.ClearPassword"/> Retirar la credencial anterior</label><button class="button primary">Guardar configuración de correo</button></form></details>
<div class="alert info">Aceptada_SMTP significa que el servidor aceptó el mensaje; no acredita entrega final ni lectura. Un resultado incierto requiere revisar el servidor y al destinatario antes de decidir otro envío.</div>
@if(Model.Jobs.Count==0){<section class="card"><p>No hay solicitudes. Prepara un reporte y selecciona su destinatario.</p></section>}
@foreach(var job in Model.Jobs){<section class="card"><div class="page-heading"><div><h2>Solicitud #@job.Id · @job.ReporteTipo</h2><p>@job.Destinatario · solicitada @Formats.Date(job.Fecha)</p><small>Reporte generado @Formats.DateWithSeconds(job.ReporteGeneradoEn)</small></div><span class="badge @(job.Estado=="Aceptada_SMTP"?"success":"warning")">@job.Estado</span></div>
@if(job.EstadoAntesCuarentena is not null){<p class="alert info">Recuperado en intervención #@job.RestauracionId. Estado en la copia: @job.EstadoAntesCuarentena. Comprueba el resultado real antes de resolver.</p>}
@if(job.UltimoError is not null){<p class="alert warning">@job.UltimoError</p>}@if(job.ProximoIntentoEn is not null){<p>Próximo intento: @Formats.DateWithSeconds(job.ProximoIntentoEn)</p>}<a class="button secondary" asp-page-handler="Download" asp-route-id="@job.Id">Descargar reporte conservado</a><details><summary>Intentos y referencia</summary><p>Message-ID: @job.MessageId</p><div class="table-wrap"><table><thead><tr><th>Intento</th><th>Inicio</th><th>Resultado</th><th>Etapa</th><th>Código SMTP</th><th>Detalle</th></tr></thead><tbody>@foreach(var attempt in Model.Attempts.Where(x=>x.SolicitudCorreoId==job.Id)){<tr><td>@attempt.Numero</td><td>@Formats.DateWithSeconds(attempt.Inicio)</td><td>@attempt.Resultado</td><td>@attempt.EtapaSMTP</td><td>@attempt.CodigoSMTP</td><td>@attempt.ErrorCodigo</td></tr>}</tbody></table></div>@if(job.ResueltoEn is not null){<p>Resolución: @job.Resolucion · @job.MotivoResolucion</p>}</details>
@if(job.Estado is "Fallida" or "Incierta" or "Pendiente" or "En_cuarentena"){<details><summary>Resolver esta solicitud</summary><p class="alert warning">Solicitar un nuevo envío puede generar un duplicado si el anterior fue aceptado. Se conservará el mismo archivo y se asignará otro Message-ID.</p><form method="post" asp-page-handler="Resolve"><input name="id" value="@job.Id" type="hidden"/><input name="hash" value="@MailQueue.ReviewHash(job)" type="hidden"/><label for="resolution-@job.Id">Resolución</label><select name="resolution" id="resolution-@job.Id">@if(job.Estado=="Fallida"){<option value="reintentar_mismo">Reintentar el envío no aceptado</option>}<option value="no_reenviar">Cerrar sin reenviar</option><option value="nueva_solicitud">Cerrar y solicitar otro envío explícito</option></select><label for="reason-@job.Id">Motivo y evidencia de comprobación</label><textarea name="reason" id="reason-@job.Id" maxlength="1000" required></textarea><label class="check-row"><input name="checkedServer" type="checkbox" value="true" required/> Comprobé el servidor y al destinatario; asumo la resolución</label><button class="button primary">Registrar resolución del correo</button></form></details>}
</section>}
