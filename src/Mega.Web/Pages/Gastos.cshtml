@page
@model Mega.Web.Pages.GastosModel
@using Mega.Web.Services
@{ViewData["Title"]="Gastos operativos";}
<div class="page-heading"><div><span class="eyebrow">GESTIÓN</span><h1>Gastos operativos</h1><p class="muted">Registro para resultados de gestión. No descuenta dinero de un turno de caja.</p></div></div><partial name="_Notice"/>
<div class="editor-grid"><section class="card"><h2>@(Model.Input.Corrects is null?"Registrar gasto":"Registrar corrección")</h2><form method="post"><input asp-for="Input.Key" type="hidden"/><input asp-for="Input.Corrects" type="hidden"/><input asp-for="Input.ReviewHash" type="hidden"/><label asp-for="Input.Date">Fecha del gasto</label><input asp-for="Input.Date" type="date" required/><label asp-for="Input.Concept">Concepto</label><input asp-for="Input.Concept" maxlength="500" required/><label asp-for="Input.Amount">Importe del gasto (C$)</label><input asp-for="Input.Amount" inputmode="decimal" required/><label asp-for="Input.Receipt">Referencia del comprobante</label><input asp-for="Input.Receipt" maxlength="500"/>
@if(Model.Input.Corrects is long id){<p class="alert info">Corrige el gasto #@id. Su contenido se conserva y el nuevo registro lo sustituye en reportes.</p><label asp-for="Input.Reason">Motivo de corrección</label><textarea asp-for="Input.Reason" required maxlength="1000"></textarea>}
<button class="button primary">Guardar gasto</button></form></section><section class="card"><h2>Historial</h2><p class="muted small">Últimos 100 registros. Los reportes usan solo el último registro vigente de cada corrección.</p><div class="table-wrap"><table><thead><tr><th>Referencia</th><th>Fecha y concepto</th><th>Importe</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>#@row.Id @if(row.CorrigeAId is long previous){<small>Corrige #@previous</small>}</td><td>@Formats.Date(row.Fecha)<br/>@row.Concepto<small>@row.ComprobanteReferencia</small>@if(row.MotivoCorreccion is not null){<small>Corrección: @row.MotivoCorreccion</small>}@if(row.MotivoAnulacion is not null){<small>Anulación: @row.MotivoAnulacion</small>}</td><td>@Formats.Money(row.ImporteCentavos)</td><td>@row.Estado</td><td>@if(row.Estado=="Registrado"){<a asp-page="/Gastos" asp-route-corrects="@row.Id">Corregir</a><details><summary>Anular</summary><form method="post" asp-page-handler="Cancel"><input name="id" value="@row.Id" type="hidden"/><input name="hash" value="@ExpenseService.ReviewHash(row)" type="hidden"/><label for="cancel-@row.Id">Motivo de anulación</label><input name="reason" id="cancel-@row.Id" required maxlength="1000"/><button class="button secondary">Anular gasto</button></form></details>}</td></tr>}</tbody></table></div></section></div>
