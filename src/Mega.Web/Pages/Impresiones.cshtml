@page
@model Mega.Web.Pages.ImpresionesModel
@using Mega.Web.Services
@{ViewData["Title"]="Comprobantes e impresión";}
<div class="page-heading"><div><span class="eyebrow">COMPROBANTES</span><h1>Impresión y entregas</h1><p class="muted">La venta ya está guardada. Aceptación de Windows y entrega física se registran por separado.</p></div></div>
<partial name="_Notice"/>
@if(Model.Manager){<section class="card"><h2>Equipo local</h2><p>Impresoras instaladas: @(Model.Printers.Count==0?"Ninguna disponible":string.Join(", ",Model.Printers))</p><p class="muted">Microsoft Print to PDF crea un archivo local; no acredita papel entregado. OneNote requiere interacción y no se admite como destino automático.</p><a class="button secondary" asp-page="/Configuracion">Configurar y habilitar impresora</a></section>}
@if(Model.SaleId is long saleId){<section class="card"><h2>Solicitar copia</h2><p>Conserva folio e importes históricos y se marca como copia. Resuelve primero cualquier trabajo pendiente o incierto.</p><form method="post" asp-page-handler="Copy"><input name="saleId" value="@saleId" type="hidden"/><input name="key" value="@Guid.NewGuid()" type="hidden"/><label for="copy-reason">Motivo de copia</label><input id="copy-reason" name="reason" maxlength="1000" required/><button class="button secondary">Solicitar copia del mismo folio</button></form></section>}
@if(Model.Jobs.Count==0){<section class="card"><p>No hay trabajos en este alcance.</p></section>}
@foreach(var job in Model.Jobs){var deliveries=Model.Deliveries.Where(x=>x.SolicitudImpresionId==job.Id).ToList();
<section class="card"><div class="page-heading"><div><h2>@Model.Folios[job.VentaId] · @(job.Tipo=="original"?"Original":$"Copia #{job.CopiaNumero}")</h2><p>@job.ImpresoraHistorica · @Formats.DateWithSeconds(job.Fecha)</p></div><span class="badge @(job.Estado=="Aceptada"?"success":"warning")">@job.Estado</span></div>
@if(job.UltimoError is not null){<div class="alert warning">@job.UltimoError</div>}
<a asp-page="/Comprobante" asp-route-id="@job.VentaId">Ver comprobante histórico</a> · <a asp-page="/Impresiones" asp-route-saleId="@job.VentaId">Gestionar este folio</a>
<details><summary>Intentos y resolución</summary><div class="table-wrap"><table><thead><tr><th>Intento</th><th>Inicio</th><th>Resultado</th><th>Referencia de Windows</th><th>Evidencia / error</th></tr></thead><tbody>@foreach(var attempt in Model.Attempts.Where(x=>x.SolicitudImpresionId==job.Id)){<tr><td>@attempt.Numero</td><td>@Formats.DateWithSeconds(attempt.Inicio)</td><td>@attempt.Resultado</td><td>@attempt.IdTrabajoSO</td><td>@attempt.Evidencia @attempt.ErrorCodigo</td></tr>}</tbody></table></div>@if(job.ResueltoEn is not null){<p>Resolución: @job.Resolucion · @job.MotivoResolucion · @Formats.DateWithSeconds(job.ResueltoEn)</p>}</details>
@if(deliveries.Count>0){@foreach(var delivery in deliveries){<p class="alert info">Entrega declarada: @delivery.Tipo · @Formats.Date(delivery.Fecha) · @delivery.EvidenciaReferencia</p>}}
else if(job.Estado=="Aceptada"){<form method="post" asp-page-handler="Deliver"><input name="id" value="@job.Id" type="hidden"/><input name="SaleId" value="@Model.SaleId" type="hidden"/><label for="delivery-@job.Id">Referencia de entrega</label><input id="delivery-@job.Id" name="evidence" maxlength="1000" required/><label class="check-row"><input type="checkbox" name="handedOver" value="true" required/> Entregué el comprobante físico al cliente</label><button class="button secondary">Registrar entrega física</button></form>}
@if(Model.Manager&&job.Estado is "Fallida" or "Incierta" or "Pendiente"){<details><summary>Resolver este trabajo</summary><div class="alert warning">Comprueba la cola de Windows y el papel. Emitir otra copia puede producir un duplicado si el trabajo anterior sí salió. La contingencia registra un comprobante manual ya entregado.</div><form method="post" asp-page-handler="Resolve"><input name="id" value="@job.Id" type="hidden"/><input name="SaleId" value="@Model.SaleId" type="hidden"/><input name="hash" value="@PrintQueue.ReviewHash(job)" type="hidden"/><label for="resolution-@job.Id">Resolución</label><select id="resolution-@job.Id" name="resolution">@if(job.Estado=="Fallida"){<option value="reintentar_mismo">Reintentar el mismo trabajo no aceptado</option>}<option value="no_reenviar">Cerrar sin reenviar</option><option value="emitir_copia">Cerrar y emitir copia explícita</option><option value="contingencia_manual">Registrar contingencia manual entregada</option></select><label for="reason-@job.Id">Motivo de resolución</label><input id="reason-@job.Id" name="reason" maxlength="1000" required/><label for="evidence-@job.Id">Evidencia de comprobación</label><input id="evidence-@job.Id" name="evidence" maxlength="1000" required/><label class="check-row"><input name="checkedQueue" type="checkbox" value="true" required/> Comprobé la cola y el papel; asumo esta resolución</label><button class="button primary">Registrar resolución</button></form></details>}
</section>}
