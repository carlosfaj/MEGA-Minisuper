@page
@model Mega.Web.Pages.LotesModel
@{ViewData["Title"]="Lotes y vencimientos";}
<div class="page-heading"><div><span class="eyebrow">INVENTARIO</span><h1>Lotes y vencimientos</h1><p class="muted">Cantidades y procedencia; la consulta conserva los saldos.</p></div><a class="button secondary" asp-page="/Conteos/Index">Conteos físicos →</a></div>
<div class="alert info">@(Model.ExpirationDays is long days?$"Alerta de próximo vencimiento: {days} días, según configuración vigente.":"El umbral de próximo vencimiento está pendiente de definir en Configuración.") Los lotes vencidos requieren revisión; esta pantalla no registra salidas ni ajustes.</div>
<form method="get" class="toolbar"><label class="check-row"><input asp-for="IncludeEmpty"/> Incluir lotes agotados</label><button class="button secondary">Aplicar filtro</button></form>
<div class="card table-card"><table><thead><tr><th>Producto / lote</th><th>Vencimiento</th><th>Existencia base</th><th>Estado</th><th>Procedencia</th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.Product<small>@(r.Reference??"Sin referencia") · #@r.Id</small></td><td>@(r.Expiry??"Sin fecha")</td><td>@r.Stock @r.Unit</td><td><span class="badge @(r.State=="Disponible"?"success":"neutral")">@r.State</span></td><td>@if(r.ReceiptId is long receipt){<a asp-page="/Recepciones/Editar" asp-route-id="@receipt">Recepción #@receipt →</a>}else{<span>Consultar bitácora</span>}</td></tr>}</tbody></table>@if(Model.Rows.Count==0){<p class="empty">No hay lotes con saldo para este filtro.</p>}</div>
@if(Model.WithoutLot.Count>0){<section class="card receiving-line"><h2>Existencias sin lote identificado</h2><p class="muted">Productos con control de vencimiento y movimientos sin asignación de lote. La historia se conserva y debe conciliarse mediante un procedimiento autorizado.</p><table><thead><tr><th>Producto</th><th>Saldo sin lote</th></tr></thead><tbody>@foreach(var r in Model.WithoutLot){<tr><td>@r.Product</td><td>@r.Stock @r.Unit</td></tr>}</tbody></table></section>}
