@page
@model Mega.Web.Pages.ProveedoresModel
@{ViewData["Title"]="Proveedores";}
<div class="page-heading"><div><span class="eyebrow">ABASTECIMIENTO</span><h1>Proveedores</h1><p class="muted">Datos de contacto y procedencia de la mercadería.</p></div><a class="button secondary" asp-page="/Recepciones/Index">Recepciones →</a></div><partial name="_Notice"/>
<div class="editor-grid">@if(Model.CanEdit){<form method="post" class="card"><h2>@(Model.Input.Id is null?"Registrar proveedor":"Editar proveedor")</h2><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/>
<label asp-for="Input.Name">Nombre del proveedor</label><input asp-for="Input.Name" required maxlength="200"/><label asp-for="Input.Identification">Identificación (opcional)</label><input asp-for="Input.Identification" maxlength="100"/><label asp-for="Input.Phone">Teléfono</label><input asp-for="Input.Phone" maxlength="100"/><label asp-for="Input.Contact">Contacto</label><input asp-for="Input.Contact" maxlength="200"/><label asp-for="Input.Address">Dirección</label><textarea asp-for="Input.Address" maxlength="500"></textarea><label class="check-row"><input asp-for="Input.Active"/> Proveedor activo</label><button class="button primary">Guardar proveedor</button>@if(Model.Input.Id is not null){<a asp-page="Proveedores">Cancelar edición</a>}</form>}
<section class="card table-card"><h2>Proveedores registrados</h2><table><thead><tr><th>Nombre / identificación</th><th>Contacto</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model.Suppliers){<tr><td>@p.Nombre<small>@p.Identificacion</small></td><td>@p.Contacto<small>@p.Telefono</small></td><td>@(p.Activo==1?"Activo":"Desactivado")</td><td>@if(Model.CanEdit){<a asp-page="Proveedores" asp-route-id="@p.Id">Editar →</a>}</td></tr>}</tbody></table>@if(Model.Suppliers.Count==0){<p class="empty">Registra un proveedor antes de enviar una recepción a revisión.</p>}</section></div>
