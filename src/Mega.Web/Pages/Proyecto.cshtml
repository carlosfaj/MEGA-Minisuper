@page
@model Mega.Web.Pages.ProyectoModel
@using Mega.Web.Services
@using System.Globalization
@{ViewData["Title"]="Kanban del proyecto";var b=Model.Board;}
<div class="page-heading"><div><span class="eyebrow">MEGA · TODO EL PROYECTO</span><h1>Avance y kanban</h1><p class="muted">Desarrollo, pruebas, documentación, entrega y validaciones.</p></div><a class="button secondary" href="https://github.com/carlosfaj/MEGA-Minisuper/blob/main/docs/KANBAN.md" target="_blank" rel="noopener">Ver registro en GitHub ↗</a></div>
<section class="card project-overview" id="project-board" data-hash="@b.Hash"><div><span class="eyebrow">AVANCE GLOBAL POR CRITERIOS</span><strong id="project-percent">@b.Percent.ToString("0.#",CultureInfo.InvariantCulture)%</strong><progress value="@b.Percent.ToString(CultureInfo.InvariantCulture)" max="100" aria-label="Avance global"></progress><p>@b.Done de @b.Total criterios completados · @b.Tasks.Count tarjetas</p></div><div class="project-meta"><p><strong>Versión @b.Version</strong></p><p>@b.TestsPassed pruebas automatizadas aprobadas</p><p class="muted">Actualizado: @Formats.DateWithSeconds(b.UpdatedAt)</p><p class="help">Actualización automática al cambiar el registro de seguimiento.</p></div></section>
<div class="project-areas">@foreach(var a in b.Areas){<section class="card"><h2>@a.Name</h2><strong>@a.Percent.ToString("0.#",CultureInfo.InvariantCulture)%</strong><progress value="@a.Percent.ToString(CultureInfo.InvariantCulture)" max="100" aria-label="Avance de @a.Name"></progress><small>@a.Done / @a.Total criterios</small></section>}</div>
<details class="card project-method"><summary>Cómo se calcula el porcentaje</summary><p>@b.Methodology</p><p>Una tarjeta solo está completada cuando todos sus criterios lo están. Una función programada, una prueba automatizada y la aceptación real del negocio son criterios distintos. Las validaciones pendientes siguen contando en el total.</p></details>
<div class="project-filters"><div><label for="project-search">Buscar tarea o requisito</label><input id="project-search" type="search" placeholder="Ej. reportes, costo, manual…"/></div><div><label for="project-area">Área</label><select id="project-area"><option value="">Todas las áreas</option>@foreach(var area in b.Areas){<option value="@area.Name">@area.Name</option>}</select></div><p class="help">Filtrar no cambia el avance global.</p></div>
<div class="kanban" aria-label="Tablero del proyecto">@foreach(var lane in Mega.Web.Pages.ProyectoModel.Lanes){<section class="kanban-lane" data-lane="@lane.Key"><div class="kanban-heading"><h2>@lane.Label</h2><span class="badge" data-lane-count>@b.Tasks.Count(t=>t.Status==lane.Key)</span></div>
@foreach(var t in b.Tasks.Where(x=>x.Status==lane.Key)){<article class="kanban-card" data-area="@t.Area" data-search="@t.Id @t.Title @t.Area @string.Join(' ',t.Criteria.Select(c=>c.Label))"><div class="kanban-tag">@t.Id · @t.Area</div><h3>@t.Title</h3><div class="kanban-progress"><strong>@t.Percent.ToString("0.#",CultureInfo.InvariantCulture)%</strong><small>@t.Done / @t.Total</small></div><progress value="@t.Percent.ToString(CultureInfo.InvariantCulture)" max="100" aria-label="Avance de @t.Title"></progress>
@if(t.Blocker is not null){<p class="kanban-blocker">@t.Blocker</p>}<details><summary>Criterios y evidencias</summary><ul>@foreach(var c in t.Criteria){<li class="@(c.Done?"criterion-done":"")"><span aria-label="@(c.Done?"Completado":"Pendiente")">@(c.Done?"✓":"○")</span> @c.Label @if(c.Done&&c.Evidence is string e){<a href="@ProjectBoardService.EvidenceUrl(e)" target="_blank" rel="noopener" aria-label="Evidencia: @c.Label">↗</a>}</li>}</ul>@if(t.DependsOn.Count>0){<p class="help">Depende de: @string.Join(", ",t.DependsOn)</p>}</details></article>}
</section>}</div>
@section Scripts{<script src="~/js/project.js" asp-append-version="true"></script>}
