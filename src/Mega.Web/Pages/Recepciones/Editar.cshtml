@page
@model Mega.Web.Pages.Recepciones.EditarModel
@using Mega.Web.Services
@{ViewData["Title"]=Model.Input.Id is null?"Preparar recepción":"Recepción "+Model.Input.Reference;}
<div class="page-heading"><div><span class="eyebrow">ABASTECIMIENTO · @Model.State</span><h1>@ViewData["Title"]</h1><p class="muted">Guardar no mueve existencias. Antes de enviar, guarda todos los cambios.</p></div><a class="button secondary" asp-page="Index">Volver</a></div><partial name="_Notice"/>
@if(!Model.Editable){<div class="alert info">Consulta del registro. Solo quien lo preparó puede editarlo; una recepción confirmada conserva su contenido.</div>}
<form method="post"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/><input asp-for="Input.Key" type="hidden"/>
<fieldset disabled="@(!Model.Editable)" class="plain-fieldset"><section class="card"><h2>Documento del proveedor</h2><div class="form-grid">
<div><label asp-for="Input.Reference">Referencia interna única</label><input asp-for="Input.Reference" required maxlength="100"/></div>
<div><label asp-for="Input.SupplierId">Proveedor</label><select asp-for="Input.SupplierId"><option value="">Por completar</option>@foreach(var p in Model.Suppliers){<option value="@p.Id">@p.Nombre @(p.Activo==0?"(desactivado)":"")</option>}</select></div>
<div><label asp-for="Input.Document">Número de documento del proveedor</label><input asp-for="Input.Document" maxlength="100"/></div><div><label asp-for="Input.DocumentDate">Fecha del documento</label><input asp-for="Input.DocumentDate" type="date"/></div>
</div><label asp-for="Input.Notes">Observaciones de la recepción</label><textarea asp-for="Input.Notes" maxlength="2000"></textarea><p class="help">Moneda NIO. Las cantidades se expresan en presentaciones y se convierten a la unidad base indicada. El costo es C$ por unidad base, hasta 6 decimales; vacío queda desconocido y bloquea la confirmación de lo aceptado.</p></section>
@for(var i=0;i<Model.Input.Lines.Count;i++){<section class="card receiving-line"><h2>Línea @(i+1)</h2><label asp-for="Input.Lines[i].PresentationId">Producto y presentación</label><select asp-for="Input.Lines[i].PresentationId"><option value="0">Selecciona una presentación (deja la línea vacía para omitirla)</option>@foreach(var p in Model.Options){<option value="@p.Id">@p.Text</option>}</select>
<div class="form-grid"><div><label asp-for="Input.Lines[i].Received">Cantidad recibida</label><input asp-for="Input.Lines[i].Received" inputmode="decimal" maxlength="32"/></div><div><label asp-for="Input.Lines[i].Accepted">Cantidad aceptada</label><input asp-for="Input.Lines[i].Accepted" inputmode="decimal" maxlength="32"/></div><div><label asp-for="Input.Lines[i].BaseCost">Costo C$ por unidad base</label><input asp-for="Input.Lines[i].BaseCost" inputmode="decimal" maxlength="32"/></div><div><label asp-for="Input.Lines[i].Lot">Referencia de lote</label><input asp-for="Input.Lines[i].Lot" maxlength="100"/></div><div><label asp-for="Input.Lines[i].Expiry">Vencimiento</label><input asp-for="Input.Lines[i].Expiry" type="date"/></div></div><label asp-for="Input.Lines[i].Note">Observación / motivo de rechazo parcial</label><input asp-for="Input.Lines[i].Note" maxlength="1000"/></section>}
<div class="toolbar"><button class="button primary">Guardar preparación</button><button class="button secondary" asp-page-handler="AddLine" formnovalidate>Añadir línea</button></div></fieldset></form>
@if(Model.Input.Id is not null){<section class="card receiving-line"><h2>Revisiones e historia</h2><p class="muted">Versión guardada: @Model.Input.Version. Editar invalida las revisiones anteriores; otra cuenta de gestión debe decidir.</p>
@if(Model.Editable){<form method="post" asp-page-handler="Submit"><input name="Input.Id" type="hidden" value="@Model.Input.Id"/><input name="Input.Version" type="hidden" value="@Model.Input.Version"/><button class="button primary">Enviar versión guardada a revisión</button></form>}
<table><thead><tr><th>Versión</th><th>Solicitud</th><th>Decisión</th><th></th></tr></thead><tbody>@foreach(var a in Model.Reviews){<tr><td>@a.ObjetoVersion</td><td>@Formats.DateWithSeconds(a.FechaSolicitud)</td><td>@a.Decision @(a.InvalidadaEn is null?"":"· invalidada")</td><td><a asp-page="Revision" asp-route-id="@a.Id">Ver contenido revisado →</a></td></tr>}</tbody></table></section>}
