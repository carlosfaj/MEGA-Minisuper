@page
@model Mega.Web.Pages.ReportesModel
@using Mega.Web.Services
@{ViewData["Title"]="Reportes";}
<div class="page-heading"><div><span class="eyebrow">CONSULTA</span><h1>Reportes</h1><p class="muted">Resultados de operaciones registradas, con su alcance y criterios de cálculo.</p></div></div><partial name="_Notice"/>
<section class="card"><form method="get" class="form-grid"><div><label asp-for="Kind">Reporte</label><select asp-for="Kind">@foreach(var kind in ReportService.Kinds.Where(x=>Model.Manager||x.Key=="inventario")){<option value="@kind.Key">@kind.Value</option>}</select></div><div><label asp-for="From">Desde, fecha local</label><input asp-for="From" type="date" required/></div><div><label asp-for="To">Hasta, fecha local</label><input asp-for="To" type="date" required/></div><div><label asp-for="ProductId">Producto, ventas e inventario</label><select asp-for="ProductId"><option value="">Todos</option>@foreach(var p in Model.Products){<option value="@p.Key">@p.Value</option>}</select></div>@if(Model.Manager){<div><label asp-for="OperatorId">Operador, solo caja</label><select asp-for="OperatorId"><option value="">Todos</option>@foreach(var u in Model.Operators){<option value="@u.Key">@u.Value</option>}</select></div>}<button class="button primary">Consultar reporte</button></form><p class="muted small">Inventario muestra existencias actuales. Las fechas corresponden a ventas, caja y resultados; máximo 367 días y 5000 filas.</p></section>
@if(Model.Report is {} report){<section class="card"><div class="page-heading"><div><h2>@report.Title</h2><p>@report.Period · @report.Scope</p><small>Generado @Formats.DateWithSeconds(report.GeneratedAt) · moneda NIO</small></div><div class="actions"><a class="button secondary" asp-page-handler="Export" asp-route-format="pdf" asp-route-Kind="@Model.Kind" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-ProductId="@Model.ProductId" asp-route-OperatorId="@Model.OperatorId">Descargar PDF</a><a class="button secondary" asp-page-handler="Export" asp-route-format="xlsx" asp-route-Kind="@Model.Kind" asp-route-From="@Model.From" asp-route-To="@Model.To" asp-route-ProductId="@Model.ProductId" asp-route-OperatorId="@Model.OperatorId">Descargar Excel</a></div></div><div class="alert info">@report.Note</div><div class="report-metrics">@foreach(var metric in report.Metrics){<div><span>@metric.Label</span><strong>@metric.Value</strong></div>}</div></section>
@foreach(var table in report.Tables){<section class="card"><h2>@table.Title</h2><p class="muted small">@table.Rows.Count registros. @if(table.Rows.Count>250){<span>Se muestran 250; las descargas incluyen todos los registros del filtro.</span>}</p><div class="table-wrap"><table><thead><tr>@foreach(var header in table.Headers){<th>@header</th>}</tr></thead><tbody>@foreach(var row in table.Rows.Take(250)){<tr>@foreach(var cell in row){<td>@cell.Text</td>}</tr>}</tbody></table></div>@if(table.Rows.Count==0){<p>Sin registros en este alcance.</p>}</section>}}

@if(Model.Manager&&Model.Report is not null){<section class="card"><h2>Enviar este reporte por correo</h2><p class="muted">Se guardará una copia del reporte al solicitarlo. Revisa destinatario y formato antes de ponerlo en cola.</p><form method="post" asp-page-handler="Correo"><input name="Kind" value="@Model.Kind" type="hidden"/><input name="From" value="@Model.From" type="hidden"/><input name="To" value="@Model.To" type="hidden"/><input name="ProductId" value="@Model.ProductId" type="hidden"/><input name="OperatorId" value="@Model.OperatorId" type="hidden"/><input name="key" value="@Guid.NewGuid()" type="hidden"/><label for="report-recipient">Destinatario del reporte</label><input name="recipient" id="report-recipient" type="email" maxlength="254" required/><label for="report-format">Formato del adjunto</label><select name="format" id="report-format"><option value="pdf">PDF</option><option value="xlsx">Excel</option></select><button class="button primary">Solicitar envío del reporte</button></form></section>}
