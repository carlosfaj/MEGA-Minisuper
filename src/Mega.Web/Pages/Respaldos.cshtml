@page
@model Mega.Web.Pages.RespaldosModel
@using Mega.Web.Services
@{ViewData["Title"]="Respaldos";}
<div class="page-heading"><div><span class="eyebrow">CONTINUIDAD</span><h1>Respaldos verificables</h1><p class="muted">Base de datos, reportes conservados, credenciales protegidas y salidas PDF administradas.</p></div></div><partial name="_Notice"/>
@if(Model.Owner){<details class="card"><summary>Destino y pauta del Propietario</summary><form method="post" asp-page-handler="Policy"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/><label asp-for="Input.Destination">Carpeta de respaldo, ruta completa</label><input asp-for="Input.Destination" maxlength="1000" required placeholder="Ejemplo: E:\Respaldos MEGA"/><label asp-for="Input.Medium">Identificación del medio</label><input asp-for="Input.Medium" maxlength="100" required placeholder="USB del negocio o carpeta de ensayo"/><p class="muted small">Selecciona una carpeta existente en el medio previsto. Una carpeta del mismo equipo sirve para ensayar; la protección externa debe comprobarse con el medio real.</p><label class="check-row"><input asp-for="Input.Periodic"/> Autorizar copias periódicas</label><label asp-for="Input.Minutes">Intervalo de copia o reintento, minutos</label><input asp-for="Input.Minutes" type="number" min="2" max="1440"/><label class="check-row"><input asp-for="Input.OnClose"/> Autorizar copia tras un cierre nuevo</label><label class="check-row"><input asp-for="Input.BeforeUpdate"/> Autorizar copia antes de aplicar otra versión de la aplicación</label><p class="muted small">Las opciones automáticas comienzan al autorizarlas. Se conservan las copias anteriores; no hay borrado automático. La propuesta de 30 minutos requiere comprobar capacidad y medios reales.</p><button class="button primary">Guardar y autorizar pauta</button></form></details>}
<section class="card"><h2>Destino actual</h2>@if(Model.Policy is {} policy){<p class="backup-destination">@policy.Destination</p><p>Medio: @policy.Medium</p><p>Periódico: @(policy.Periodic?$"cada {policy.Minutes} minutos":"deshabilitado") · al cierre: @(policy.OnClose?"autorizado":"deshabilitado") · antes de otra versión: @(policy.BeforeUpdate?"autorizado":"deshabilitado")</p><form method="post" asp-page-handler="Run"><input name="key" value="@Guid.NewGuid()" type="hidden"/><button class="button primary">Generar y comprobar respaldo</button></form>}else{<p>El Propietario debe autorizar una carpeta y una pauta. Las copias automáticas permanecen deshabilitadas.</p>}</section>
<div class="alert info">Una copia se considera comprobada al verificar su huella, manifiesto, archivos e integridad de la base. El archivo contiene información del negocio: conserva el medio bajo su control. Las credenciales protegidas requieren el perfil original de Windows o nueva configuración al recuperar.</div>
<section class="card"><h2>Ejecuciones</h2><p class="muted small">Últimas 100 ejecuciones; un fallo no borra copias anteriores.</p><div class="table-wrap"><table><thead><tr><th>Fecha</th><th>Origen y medio</th><th>Resultado</th><th>Detalle</th><th>Acciones</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>#@row.Id<br/>@Formats.DateWithSeconds(row.Inicio)</td><td>@row.Origen<small>@row.MedioIdentificador</small></td><td><span class="badge @(row.Estado=="Comprobada"?"success":"warning")">@row.Estado</span></td><td>@row.UltimoError@if(row.ComprobadoEn is not null){<small>Comprobada @Formats.DateWithSeconds(row.ComprobadoEn)</small>}@if(row.TamanoBytes is long bytes){<small>@bytes bytes · esquema @row.VersionEsquema</small>}<details><summary>Huella y punto de copia</summary><p class="audit-detail">@row.ArchivoReferencia</p><p class="audit-detail">@row.Checksum</p><pre class="audit-detail">@row.Manifiesto</pre></details></td><td>@if(row.Checksum is not null){<form method="post" asp-page-handler="Verify"><input name="id" value="@row.Id" type="hidden"/><button class="button secondary">Comprobar de nuevo</button></form>}@if(row.Estado=="Comprobada"){<a class="button secondary" asp-page-handler="Download" asp-route-id="@row.Id">Descargar copia</a>}</td></tr>}</tbody></table></div></section>
