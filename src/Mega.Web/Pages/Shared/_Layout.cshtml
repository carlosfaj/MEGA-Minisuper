@using System.Security.Claims
@using Mega.Web.Presentation
@inject IConfiguration Configuration
@{
    var signed = User.Identity?.IsAuthenticated == true;
    var cash = User.HasClaim("caja", "1");
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var login = current == "/Acceso";
    var role = User.FindFirstValue(ClaimTypes.Role);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#18392d" />
    <title>@ViewData["Title"] · MEGA</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/branded.css" asp-append-version="true" />
    <script src="~/js/navigation.js" asp-append-version="true" defer></script>
</head>
<body class="@(login ? "login-page" : "")">
<a class="skip" href="#contenido">Ir al contenido</a>
@if (signed)
{
    <button class="menu-backdrop" type="button" aria-label="Cerrar menú" hidden></button>
    <aside id="sidebar" class="sidebar" aria-label="Menú de MEGA">
        <div class="sidebar-panel">
            <div class="brand-row">
                <a class="brand" asp-page="/Index" aria-label="MEGA · Inicio">
                    <img class="brand-full" src="~/brand/logo.svg" alt="MEGA" width="120" height="63.75" />
                    <img class="brand-compact" src="~/brand/compact.svg" alt="MEGA" />
                </a>
                <button id="sidebar-toggle" class="icon-button" type="button" aria-label="Reducir menú" aria-expanded="true" aria-controls="navigation"><img src="~/brand/arrow.svg" alt="" /></button>
                <button id="mobile-close" class="button secondary" type="button">Cerrar menú</button>
            </div>
            <partial name="_Navigation" model="Navigation.For(User, current)" />
            <div class="sidebar-bottom"><span class="service-status"><img src="~/brand/available.svg" alt="" /><span class="nav-text">Servicio local disponible</span></span><small class="nav-text">@role · Estación @Configuration["MEGA:Station"]</small></div>
        </div>
    </aside>
}
<div class="shell @(signed ? "" : "anonymous")">
    @if (!login)
    {
        <header class="topbar">
            <a class="mobile-brand" asp-page="/Index" aria-label="MEGA · Inicio"><img src="~/brand/logo.svg" alt="MEGA" width="92" height="48.875" /></a>
            <span class="topbar-title">Minisúper MEGA / @ViewData["Title"]</span>
            <div class="topbar-right">
                @if (Configuration.GetValue<bool>("MEGA:DemoData")) { <span class="demo-label" title="Demostración · datos ficticios">DEMO<span class="desktop-demo">STRACIÓN</span></span> }
                @if (signed)
                {
                    <span class="badge success topbar-service">● Servicio local</span>
                    <span class="account">@User.Identity?.Name <span>· @role</span></span>
                    <form method="post" asp-page="/Salir"><button class="icon-button logout-button" type="submit" aria-label="Salir" title="Salir"><img src="~/brand/logout.svg" alt="" /></button></form>
                    <button id="mobile-menu" class="button secondary" type="button" aria-expanded="false" aria-controls="sidebar">Menú</button>
                }
            </div>
        </header>
    }
    <main id="contenido">@RenderBody()</main>
    @if (!login) { <footer>MEGA · Tu tienda, en orden <span>Operación local · hora UTC−6 provisional</span></footer> }
</div>
@if (signed && cash)
{
    <nav class="mobile-navigation" aria-label="Accesos rápidos móviles">
        <a class="button @(current == "/Index" ? "primary" : "secondary")" asp-page="/Index" aria-current="@(current == "/Index" ? "page" : null)">Inicio</a>
        <a class="button @(current == "/Venta" ? "primary" : "secondary")" asp-page="/Venta" aria-current="@(current == "/Venta" ? "page" : null)">Venta</a>
        <a class="button @(current == "/Caja" ? "primary" : "secondary")" asp-page="/Caja" aria-current="@(current == "/Caja" ? "page" : null)">Mi caja</a>
    </nav>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
