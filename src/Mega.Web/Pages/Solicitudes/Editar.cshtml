@page
@model Mega.Web.Pages.Solicitudes.EditarModel
@{ViewData["Title"]=Model.TypeName;}
<div class="page-heading"><div><span class="eyebrow">SOLICITUD DE INVENTARIO · @(Model.Saved?.Estado??"NUEVA")</span><h1>@Model.TypeName</h1><p class="muted">Guarda los cambios antes de enviar. Solo una revisión vigente por otra cuenta permite aplicar efectos.</p></div><a class="button secondary" asp-page="Index">Volver</a></div><partial name="_Notice"/>
<div class="alert info">Las operaciones con lotes o con existencias de costo conocido requieren valoración, todavía pendiente. Se conserva el costo desconocido sin convertirlo en cero.</div>
<form method="post"><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/><input asp-for="Input.Key" type="hidden"/><input asp-for="Input.Type" type="hidden"/><fieldset class="plain-fieldset" disabled="@(!Model.Editable)"><section class="card"><label asp-for="Input.Reference">Referencia única de solicitud</label><input asp-for="Input.Reference" required maxlength="100"/>
@if(Model.Input.Type=="ajuste"){<label asp-for="Input.CountId">Conteo finalizado</label><select asp-for="Input.CountId"><option value="">Selecciona un conteo</option>@foreach(var c in Model.Counts){<option value="@c.Id">@c.Referencia · versión @c.Version</option>}</select><p class="help">El servidor toma las diferencias del conteo. Si hubo movimientos posteriores, se requiere un conteo nuevo. No se introducen cantidades manuales de ajuste.</p>}
<label asp-for="Input.Reason">Motivo de la solicitud</label><textarea asp-for="Input.Reason" required maxlength="1000"></textarea><label asp-for="Input.Evidence">Referencia de evidencia</label><input asp-for="Input.Evidence" required maxlength="1000"/><p class="help">Indica dónde se conserva el documento, fotografía o acta; no introduce dinero en caja.</p></section>
@if(Model.Input.Type!="ajuste"){@for(var i=0;i<Model.Input.Lines.Count;i++){<section class="card receiving-line"><h2>Línea @(i+1)</h2><label asp-for="Input.Lines[i].ProductId">Producto y unidad base</label><select asp-for="Input.Lines[i].ProductId"><option value="0">Selecciona producto</option>@foreach(var p in Model.Products){<option value="@p.Id">@p.Nombre · @p.UnidadBase</option>}</select><div class="form-grid"><div><label asp-for="Input.Lines[i].Quantity">Cantidad positiva en unidad base</label><input asp-for="Input.Lines[i].Quantity" inputmode="decimal" maxlength="32"/></div>
@if(Model.Input.Type=="carga"){<div><label asp-for="Input.Lines[i].BaseCost">Costo C$ por unidad base (vacío = desconocido)</label><input asp-for="Input.Lines[i].BaseCost" inputmode="decimal" maxlength="32"/></div>}else{<div><label asp-for="Input.Lines[i].Cause">Causa de salida</label><select asp-for="Input.Lines[i].Cause"><option value="">Selecciona causa</option><option value="devolucion_proveedor">Devolución a proveedor</option><option value="robo">Robo</option><option value="dano">Daño</option><option value="vencimiento">Vencimiento</option><option value="perdida">Pérdida</option><option value="consumo_interno">Consumo interno</option></select></div><div><label asp-for="Input.Lines[i].ReturnSupplierId">Proveedor de devolución (si corresponde)</label><select asp-for="Input.Lines[i].ReturnSupplierId"><option value="">No corresponde</option>@foreach(var p in Model.Suppliers){<option value="@p.Id">@p.Nombre</option>}</select></div>}
</div><label asp-for="Input.Lines[i].Evidence">Evidencia específica de línea (opcional)</label><input asp-for="Input.Lines[i].Evidence" maxlength="1000"/></section>}}
@if(Model.Editable){<div class="toolbar"><button class="button primary">Guardar solicitud</button>@if(Model.Input.Type!="ajuste"){<button class="button secondary" asp-page-handler="AddLine" formnovalidate>Añadir línea</button>}</div>}</fieldset></form>
@if(Model.Saved is not null){<section class="card receiving-line"><h2>Versión guardada @Model.Saved.Version</h2>@if(Model.Editable){<form method="post" asp-page-handler="Submit"><input name="Input.Id" type="hidden" value="@Model.Saved.Id"/><input name="Input.Version" type="hidden" value="@Model.Saved.Version"/><button class="button primary">Enviar versión guardada a revisión</button></form>}
<table><thead><tr><th>Versión</th><th>Decisión</th><th></th></tr></thead><tbody>@foreach(var a in Model.Reviews){<tr><td>@a.ObjetoVersion</td><td>@a.Decision @(a.InvalidadaEn is null?"":"· invalidada")</td><td><a asp-page="Revision" asp-route-id="@a.Id">Ver contenido revisado →</a></td></tr>}</tbody></table>
@if(Model.Editable){<form method="post" asp-page-handler="Cancel"><input name="Input.Id" type="hidden" value="@Model.Saved.Id"/><input name="Input.Version" type="hidden" value="@Model.Saved.Version"/><label asp-for="CancelReason">Motivo de cancelación</label><input asp-for="CancelReason" required maxlength="1000"/><button class="button secondary">Cancelar solicitud</button></form>}</section>}
