@page
@model Mega.Web.Pages.Solicitudes.RevisionModel
@using Mega.Web.Services
@{ViewData["Title"]="Revisar inventario";}
<div class="page-heading"><div><span class="eyebrow">REVISIÓN POR OTRA CUENTA</span><h1>@Model.Reviewed.Reference</h1><p class="muted">@Model.Reviewed.Type.Replace('_',' ') · versión @Model.Reviewed.Version</p></div><a class="button secondary" asp-page="Editar" asp-route-id="@Model.Reviewed.RequestId">Ver solicitud</a></div><partial name="_Notice"/>
<div class="alert info">Estado: @Model.Review.Decision. @(Model.Legacy?"Registro inicial de demostración: se consulta el detalle de la operación original.":Model.Review.Decision!="pendiente"?"Contenido histórico de la decisión registrada.":Model.Current?"El contenido y las existencias coinciden con lo revisado.":"El contenido o las existencias cambiaron; se requiere guardar y enviar una versión nueva.")</div>
<section class="card"><h2>Motivo y evidencia</h2><p>@Model.Reviewed.Reason</p><p>@Model.Reviewed.Evidence</p>@if(Model.Reviewed.CountId is long c){<p><a asp-page="/Conteos/Editar" asp-route-id="@c">Conteo #@c · versión @Model.Reviewed.CountVersion →</a></p>}
@foreach(var d in Model.Reviewed.Lines){<div class="subsection"><h3>@d.Number. @d.Product</h3><p>@(Model.Legacy?"Saldo actual de consulta":"Saldo al revisar"): @(d.Balance/ReceivingService.Power(d.Scale)) @d.Unit</p><p>Cambio solicitado: <strong>@(d.Quantity/ReceivingService.Power(d.Scale)) @d.Unit</strong></p><p>Costo: @(d.CostState=="desconocido"?"Desconocido (no equivale a cero)":"C$ "+(d.BaseCost/ReceivingService.Power(d.CostScale!.Value))+" por "+d.Unit)</p><p>@d.Cause?.Replace('_',' ') @d.Supplier</p><p>@d.Evidence</p></div>}
</section><section class="card receiving-line"><h2>Decisión de gestión</h2><p class="content-hash">Huella: @Model.Review.ContenidoHash</p>
@if(Model.CanDecide){<form method="post"><input asp-for="Id" type="hidden"/><input asp-for="ExpectedVersion" type="hidden"/><input asp-for="ExpectedHash" type="hidden"/><label asp-for="Reason">Motivo de la decisión</label><textarea asp-for="Reason" required maxlength="1000"></textarea><div class="toolbar"><button class="button primary" asp-page-handler="Approve">Autorizar y aplicar una vez</button><button class="button secondary" asp-page-handler="Reject">Rechazar solicitud</button></div></form>}else if(Model.Review.Decision=="pendiente" && Model.Current){<p>Debe decidir otra cuenta Administrador o Propietario.</p>}else{<p>@Model.Review.Motivo</p>}
</section>
