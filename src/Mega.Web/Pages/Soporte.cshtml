@page
@model Mega.Web.Pages.SoporteModel
@using Mega.Web.Services
@{ViewData["Title"]="Diagnóstico de soporte";}
<div class="page-heading"><div><span class="eyebrow">SOPORTE TEMPORAL</span><h1>Diagnóstico de integridad</h1><p class="muted">Autorización de lectura técnica hasta @Formats.DateWithSeconds(Model.End).</p></div></div>
<div class="stats"><div class="card stat"><span>Integridad física y relaciones</span><strong>@(Model.Integrity?"Correcta":"Requiere revisión")</strong></div><div class="card stat"><span>Versión de esquema</span><strong>@Model.Schema</strong></div></div>
<div class="alert info">Este acceso permite revisar el estado técnico. El Propietario puede revocarlo en cualquier momento. La consulta queda en bitácora.</div>
