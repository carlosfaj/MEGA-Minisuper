@page
@model Mega.Web.Pages.VentaModel
@{ViewData["Title"]="Nueva venta";}
<div class="page-heading"><div><span class="eyebrow">PUNTO DE VENTA</span><h1>Nueva venta</h1><p class="muted">Busca un producto, revisa la compra y continúa al cobro.</p></div><span class="badge neutral">Efectivo</span></div>
@if(!Model.HasShift){<section class="card empty"><span class="tile-icon">▤</span><h2>Primero abre tu caja</h2><p class="muted">Necesitas un turno propio abierto para preparar y confirmar una venta.</p><a class="button primary" asp-page="/Caja">Ir a Mi caja →</a></section>}
else{
<div id="sale-app" data-account="@Model.AccountId">@Html.AntiForgeryToken()<div id="sale-error" class="alert error" role="alert" hidden></div>
<div class="pos-grid"><div><section class="card"><div class="card-heading"><h2>Añadir productos</h2><span class="muted small">Nombre o código</span></div><label for="search" class="sr-only">Buscar producto</label><input id="search" type="search" placeholder="Buscar nombre o código de producto…" autocomplete="off" autofocus/><div id="product-list" class="product-list" aria-live="polite"><p class="muted">Cargando productos…</p></div>
<div id="product-editor" class="product-editor" hidden><strong id="selected-name"></strong><div class="field-grid"><div><label for="mode">Modalidad</label><select id="mode"><option value="unidad">Por unidad</option><option value="peso_manual">Peso manual</option><option value="importe">Por importe</option></select></div><div><label for="quantity" id="quantity-label">Cantidad</label><input id="quantity" inputmode="decimal" value="1"/></div></div><button id="add-product" type="button" class="button primary full">Añadir a la compra</button></div></section>
<div class="alert info">Peso manual a 3 decimales; importes a 2. El total se vuelve a calcular antes de confirmar.</div></div>
<section class="card basket"><div class="card-heading"><h2>Compra en preparación</h2><span class="badge neutral" id="item-count">0 líneas</span></div><div id="cart-lines" class="cart-lines"><div class="empty-cart"><span>＋</span><p>Tu compra está vacía</p><small>Añade el primer producto para comenzar.</small></div></div>
<div class="totals"><div><span>Subtotal</span><span id="subtotal">C$ 0.00</span></div><div class="total"><strong>Total</strong><strong id="total">C$ 0.00</strong></div><small class="muted">Comprobante interno · fiscalidad pendiente de validación</small></div>
<label id="stock-warning" class="alert warning check-label" hidden><input type="checkbox" id="physical-check"/> El saldo digital es insuficiente. Comprobé físicamente que la mercadería está disponible y dejo registrada la discrepancia.</label>
<div id="checkout" hidden><h3>Cobro en efectivo</h3><label for="received">Efectivo recibido (C$)</label><input id="received" inputmode="decimal" placeholder="0.00"/><div class="change-row"><span>Cambio</span><strong id="change">C$ 0.00</strong></div><p class="muted small">La venta se guarda una vez. La impresión automática está pendiente de integrar.</p></div>
<div class="basket-actions"><button id="continue" type="button" class="button primary full" disabled>Continuar al cobro →</button><button id="confirm" type="button" class="button primary full" hidden disabled>Confirmar venta</button><button id="back" type="button" class="button secondary full" hidden>Volver a la compra</button><button id="cancel" type="button" class="button text-button full">Cancelar preparación</button></div></section></div></div>
}
@section Scripts {<script src="~/js/sale.js" asp-append-version="true" defer></script>}
